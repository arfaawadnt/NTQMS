<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site config for the NT.QAMS SPA. Place this in the site root alongside the
  frontend files (index.html + chunks). Requires the IIS URL Rewrite and
  Application Request Routing (ARR) modules.

  It does two jobs:
    1. Reverse-proxy /api and /health (and /hubs for future SignalR) to the
       backend Kestrel service on loopback — so the SPA calls same-origin /api.
    2. SPA fallback: any non-file, non-api path serves index.html so client-side
       routes (e.g. /nonconformances) work on refresh/deep-link.

  Change the 127.0.0.1:5000 target if the backend listens elsewhere.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Proxy API to Kestrel" stopProcessing="true">
          <match url="^(api|health|metrics|hubs)(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:5000/{R:0}" />
        </rule>
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <!-- Hashed bundles are immutable; index.html must not be cached. -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>
    <!--
      SEC-011/SEC-017 (ADR-0003): defensive headers for the SPA itself. The
      strict CSP (script-src 'self', no inline/eval — Angular AOT needs none)
      is the compensating control for web-storage tokens. The API sends its
      own, even stricter set. HSTS applies once and covers both since they
      share the origin (SEC-012: TLS terminates here at IIS — see
      docs/adr/ADR-0002).
    -->
    <httpProtocol>
      <customHeaders>
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" />
        <add name="Strict-Transport-Security" value="max-age=63072000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
